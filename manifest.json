{
  "manifestVersion": 5,
  "id": "com.custom.photoshop.scanlinex",
  "name": "ScanlineX",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1],
      "theme": ["all"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "scanlinex.panel",
      "label": {
        "default": "ScanlineX"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "light", "lightest"]
        }
      ],
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 800, "height": 1400 },
      "preferredDockedSize": { "width": 300, "height": 680 },
      "preferredFloatingSize": { "width": 320, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "network": {
      "domains": [
        "https://huggingface.co",
        "https://cdn-lfs.huggingface.co",
        "https://cdn-lfs-us-1.huggingface.co"
      ]
    },
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "domains": "all",
      "enableMessageBridge": "localAndRemote"
    }
  }
}
